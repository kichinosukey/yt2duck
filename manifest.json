{
  "manifest_version": 3,
  "name": "yt2duck",
  "version": "0.1.0",
  "description": "Open YouTube videos in Duck Player from the context menu.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
